{
  "name": "air-canvas-ml-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Air Canvas: hand-gesture drawing with an in-browser ONNX gesture model",
  "license": "MIT",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "postinstall": "node scripts/copy-runtime.mjs",
    "copy:runtime": "node scripts/copy-runtime.mjs",
    "fetch:models": "node scripts/fetch-models.mjs",
    "dev": "npm run copy:runtime && vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run copy:runtime && npm run fetch:models && tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@mediapipe/tasks-vision": "^1.2.3",
    "onnxruntime-web": "^1.31.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
